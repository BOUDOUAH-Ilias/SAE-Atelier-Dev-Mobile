{% extends "home.html.twig" %}

{% block title %}Articles – Minipress{% endblock %}

{% block content %}
<h2>Articles</h2>

{% if categories is not empty %}
<div class="cat-filter">
    <a href="{{ base_path }}/articles" class="cat-filter-item {{ active_cat is null ? 'active' : '' }}">Tous</a>
    {% for cat in categories %}
        <a href="{{ base_path }}/articles/categorie/{{ cat.id }}"
           class="cat-filter-item {{ active_cat == cat.id ? 'active' : '' }}">
            {{ cat.nom }}
        </a>
    {% endfor %}
</div>
{% endif %}

{% if articles is empty %}
    <p>Aucun article pour le moment.</p>
{% else %}
    <table class="articles-table">
        <thead>
            <tr>
                <th>Titre</th>
                <th>Date</th>
                <th>Auteur</th>
                {% if current_user %}
                    <th>Statut</th>
                    <th>Action</th>
                {% endif %}
            </tr>
        </thead>
        <tbody>
            {% for article in articles %}
            {% set is_author = current_user and article.id_auteur == current_user.id %}
            {% set is_admin  = current_user and current_user.is_admin == 1 %}
            <tr class="{{ (current_user and not article.publie) ? 'unpublished' : '' }}">
                <td><a href="{{ base_path }}/article/{{ article.id }}">{{ article.titre }}</a></td>
                <td>{{ article.date_creation|date('d/m/Y') }}</td>
                <td>{{ article.auteur.email ?? '—' }}</td>
                {% if current_user %}
                <td>
                    <span class="badge {{ article.publie ? 'badge-published' : 'badge-draft' }}">
                        {{ article.publie ? 'Publié' : 'Brouillon' }}
                    </span>
                </td>
                <td>
                    {% if is_author %}
                        <form method="post" action="{{ base_path }}/article/{{ article.id }}/publier">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                            <button type="submit" class="btn btn-sm {{ article.publie ? 'btn-danger' : 'btn-success' }}">
                                {{ article.publie ? 'Dépublier' : 'Publier' }}
                            </button>
                        </form>
                    {% elseif is_admin and article.publie %}
                        <form method="post" action="{{ base_path }}/article/{{ article.id }}/publier">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                            <button type="submit" class="btn btn-sm btn-danger">Dépublier</button>
                        </form>
                    {% endif %}
                </td>
                {% endif %}
            </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}
{% endblock %}
