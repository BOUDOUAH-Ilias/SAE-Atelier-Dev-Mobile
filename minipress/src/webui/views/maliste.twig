{% extends "home.html.twig" %}

{% block title %}Mes articles – Minipress{% endblock %}

{% block content %}
<h2>Mes articles</h2>

{% if articles is empty %}
    <p>Vous n'avez pas encore écrit d'article.</p>
{% else %}
    <table class="articles-table">
        <thead>
            <tr>
                <th>Titre</th>
                <th>Date</th>
                <th>Statut</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            {% for article in articles %}
            <tr class="{{ article.publie ? '' : 'unpublished' }}">
                <td>{{ article.titre }}</td>
                <td>{{ article.date_creation|date('d/m/Y') }}</td>
                <td>
                    <span class="badge {{ article.publie ? 'badge-published' : 'badge-draft' }}">
                        {{ article.publie ? 'Publié' : 'Brouillon' }}
                    </span>
                </td>
                <td>
                    <form method="post" action="{{ base_path }}/article/{{ article.id }}/publier">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <button type="submit" class="btn btn-sm {{ article.publie ? 'btn-danger' : 'btn-success' }}">
                            {{ article.publie ? 'Dépublier' : 'Publier' }}
                        </button>
                    </form>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}
{% endblock %}
