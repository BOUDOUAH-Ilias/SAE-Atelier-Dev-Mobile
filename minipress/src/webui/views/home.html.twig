<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Minipress{% endblock %}</title>
    <link rel="stylesheet" href="{{ css_dir }}/style.css">
</head>
<body>
    <header>
        <div class="header-inner">
            <a href="{{ base_path }}/" class="site-title">Minipress</a>
            <nav>
                <a href="{{ base_path }}/articles">Articles</a>
                {% if current_user %}
                    <a href="{{ base_path }}/article/create">Nouvel article</a>
                    <a href="{{ base_path }}/categorie/create">Nouvelle catégorie</a>
                    <a href="{{ base_path }}/maliste">Mes articles</a>
                    {% if current_user.is_admin %}
                        <a href="{{ base_path }}/admin/user/create">Créer utilisateur</a>
                    {% endif %}
                    <a href="{{ base_path }}/signout" class="nav-signout">Déconnexion ({{ current_user.email }})</a>
                {% else %}
                    <a href="{{ base_path }}/signin">Connexion</a>
                {% endif %}
            </nav>
        </div>
    </header>

    <main>
        {% block content %}{% endblock %}
    </main>
</body>
</html>
