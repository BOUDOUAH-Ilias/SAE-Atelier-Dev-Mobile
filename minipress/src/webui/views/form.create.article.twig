{% extends "home.html.twig" %}

{% block title %}Nouvel article – Minipress{% endblock %}

{% block content %}

    <h2>Créer un article</h2>

    {% if error %}
        <p style="color:red;">{{ error }}</p>
    {% endif %}

    {% if not user %}

        <p style="color:red;">
            Vous devez être connecté pour créer un article.
        </p>

        <a href="{{ base_path }}/signin">Se connecter</a>

    {% else %}

        <form method="post" action="{{ base_path }}/article/create">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

            <div>
                <label for="titre">Titre *</label><br>
                <input type="text" id="titre" name="titre" required maxlength="255">
            </div><br>

            <div>
                <label for="resume">Résumé</label><br>
                <textarea id="resume" name="resume" rows="3" cols="60"></textarea>
            </div><br>

            <div>
                <label for="contenu">Contenu *</label><br>
                <textarea id="contenu" name="contenu" required rows="8" cols="60"></textarea>
            </div><br>

            <div>
                <label for="id_categorie">Catégorie *</label><br>
                <select id="id_categorie" name="id_categorie" required>
                    <option value="">-- Choisir --</option>
                    {% for categorie in categories %}
                        <option value="{{ categorie.id }}">{{ categorie.nom }}</option>
                    {% endfor %}
                </select>
            </div><br>

            <div>
                <label for="image_url">URL de l'image</label><br>
                <input type="url" id="image_url" name="image_url" maxlength="500">
            </div><br>

            <div>
                <input type="checkbox" id="publie" name="publie" value="1">
                <label for="publie">Publier immédiatement</label>
            </div><br>

            <button type="submit">Créer l'article</button>
            <a href="{{ base_path }}/">Annuler</a>

        </form>

    {% endif %}

{% endblock %}
